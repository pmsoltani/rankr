---
/**
 * Shared body for every ranking-table route (`/`, `/rankings/{system}/{year}`,
 * and `/rankings/{system}/{year}/{page}`). All three are prerendered, so this
 * runs at build time and reads from `.data/` rather than D1.
 */
import qsColor from "@/assets/images/qsColor.svg";
import shanghaiColor from "@/assets/images/shanghaiColor.svg";
import theColor from "@/assets/images/theColor.svg";
import RankingTable from "@/components/RankingTable";
import Layout from "@/layouts/Layout.astro";
import {
  getRankingSystems,
  getRankingTableData,
  pageCount,
  pageSlice,
} from "@/lib/data";
import { RANKING_SYSTEMS, SITE, type RankingSystemId } from "@/lib/site";

interface Props {
  system: RankingSystemId;
  year: number;
  page: number;
  /** Overrides for the landing page, which is this same table under `/`. */
  title?: string;
  description?: string;
}

const {
  system,
  year,
  page,
  title: titleProp,
  description: descriptionProp,
} = Astro.props;

const SYSTEM_ICON: Record<RankingSystemId, string> = {
  qs: qsColor.src,
  shanghai: shanghaiColor.src,
  the: theColor.src,
};

const systems = getRankingSystems();
const available = (Object.keys(RANKING_SYSTEMS) as RankingSystemId[]).filter(
  (id) => systems[id]?.length,
);
const years = systems[system] ?? [];

const { rows, countries } = getRankingTableData(system, year);
const pageRows = pageSlice(rows, page);
const totalPages = pageCount(rows.length);
const alias = RANKING_SYSTEMS[system].alias;

const systemOptions = available.map((id) => ({
  id,
  alias: RANKING_SYSTEMS[id].alias,
  icon: SYSTEM_ICON[id],
  href: `/rankings/${id}/${systems[id]?.includes(year) ? year : systems[id]![0]}`,
}));
const yearOptions = years.map((y) => ({
  year: y,
  href: `/rankings/${system}/${y}`,
}));

const title =
  titleProp ??
  (page > 1
    ? `${alias} World University Rankings ${year} — page ${page} — ${SITE.name}`
    : `${alias} World University Rankings ${year} — ${SITE.name}`);
const description =
  descriptionProp ??
  `The full ${alias} World University Rankings ${year} — ranks for ${rows.length.toLocaleString()} universities${page > 1 ? `, page ${page} of ${totalPages}` : ""}.`;
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    {
      /* Deep pages are real content and stay indexable, but tell crawlers where
        the sequence starts and continues rather than letting them guess. */
    }
    {
      page > 1 && (
        <link
          rel="prev"
          href={
            page === 2
              ? `/rankings/${system}/${year}`
              : `/rankings/${system}/${year}/${page - 1}`
          }
        />
      )
    }
    {
      page < totalPages && (
        <link rel="next" href={`/rankings/${system}/${year}/${page + 1}`} />
      )
    }
    <slot name="head" />
  </Fragment>

  <div class="mx-auto max-w-300 px-4 py-8">
    <h1 class="text-2xl font-bold tracking-tight">World University Rankings</h1>
    <p class="text-muted-foreground mt-1 text-sm">
      {alias}
      {year} · {rows.length.toLocaleString()} institutions
    </p>

    <div class="mt-6">
      <RankingTable
        client:idle
        system={system}
        year={year}
        rows={pageRows}
        countries={countries}
        total={rows.length}
        page={page}
        systemOptions={systemOptions}
        yearOptions={yearOptions}
      />
    </div>
  </div>
</Layout>
