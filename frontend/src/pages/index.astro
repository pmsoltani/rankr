---
import Layout from "@/layouts/Layout.astro";

export const prerender = true;
---

<Layout title="rankr">
  <main
    class="mx-auto flex min-h-screen max-w-3xl flex-col items-center justify-center gap-4 p-8 text-center"
  >
    <h1 class="text-4xl font-bold tracking-tight">rankr</h1>
    <p class="text-muted-foreground text-lg">
      Aggregating the results of different academic rankings.
    </p>
    <p class="text-muted-foreground text-sm">
      Astro + Tailwind + shadcn scaffold is live. Pages are being ported.
    </p>
  </main>
</Layout>
