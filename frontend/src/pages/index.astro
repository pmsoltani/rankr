---
import RankingPage from "@/components/RankingPage.astro";
import { getRankingSystems } from "@/lib/data";
import { SITE, type RankingSystemId } from "@/lib/site";

export const prerender = true;

// The landing table: QS's most recent year when available, else whatever is.
const systems = getRankingSystems();
const system: RankingSystemId = systems.qs?.length
  ? "qs"
  : ((Object.keys(systems)[0] ?? "qs") as RankingSystemId);
const year = systems[system]![0];
---

<RankingPage
  system={system}
  year={year}
  page={1}
  title={SITE.name}
  description="rankr aggregates the QS, Shanghai (ARWU), and Times Higher Education world university rankings — browse the tables, search any university, and track its rank and score history."
>
  <Fragment slot="head">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: SITE.name,
        url: SITE.url,
        description: SITE.description,
      })}
    />
  </Fragment>
</RankingPage>
