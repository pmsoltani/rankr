---
// Redirects /rankings/{system} to its latest available year.
import { getDb } from "@/lib/db";
import { getRankingSystems } from "@/lib/queries";
import { RANKING_SYSTEMS } from "@/lib/site";

const { system } = Astro.params;
const db = getDb();
const systems = await getRankingSystems(db);
const years = system ? systems[system] : undefined;

if (!system || !(system in RANKING_SYSTEMS) || !years?.length) {
  return Astro.rewrite("/404");
}

// years are ordered newest-first by the query.
return Astro.redirect(`/rankings/${system}/${years[0]}`);
---
