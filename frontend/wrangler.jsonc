{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rankr",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "rankr.online",
      "custom_domain": true,
    },
    {
      "pattern": "www.rankr.online",
      "custom_domain": true,
    },
  ],
  // @astrojs/cloudflare v14 deploys as a Worker with static assets (not Pages),
  // so this is a Worker config; no `pages_build_output_dir`.
  "assets": {
    "not_found_handling": "404-page",
    "run_worker_first": false,
    "html_handling": "drop-trailing-slash",
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "420897a14b60434e9336d01c9d6bdc8e",
    },
  ],
}
